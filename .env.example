# Chave da API do Google AI Studio (Obrigatória)
# Gere gratuitamente em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=SuaApiKeyGoogleAI

# (Opcional) Forçar um modelo principal específico no topo da fila de prioridade
# Padrão: gemini-3.5-flash-lite (maior cota diária: 500 RPD e 15 RPM)
# Outros: gemini-3.1-flash-lite, gemini-3.6-flash, gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# (Opcional) Limite máximo de tokens por resposta (Padrão: 500 para evitar cortes e manter respostas rápidas)
# GEMINI_MAX_TOKENS=500

# (Opcional) Orçamento de tokens de raciocínio interno (Padrão: 0 para desativar thinking e responder até 4x mais rápido na Alexa)
# GEMINI_THINKING_BUDGET=0

# (Opcional) Criatividade da resposta entre 0.0 e 1.0 (Padrão: 0.6)
# GEMINI_TEMPERATURE=0.6

# (Opcional) Orçamento máximo de tempo em segundos antes do timeout de 8s da Alexa (Padrão: 6.4)
# ALEXA_TIMEOUT_BUDGET=6.4

# (Opcional) Quantidade máxima de turnos (perguntas + respostas) mantidos no histórico (Padrão: 6)
# MAX_HISTORY_TURNS=6

# (Opcional) Personalização de Quotas por Modelo (RPM: Req/Minuto | RPD: Req/Dia)
# Ajustados de acordo com os limites gratuitos do seu painel do Google AI Studio:
# QUOTA_GEMINI_3_5_FLASH_LITE_RPM=15
# QUOTA_GEMINI_3_5_FLASH_LITE_RPD=500
# QUOTA_GEMINI_3_1_FLASH_LITE_RPM=15
# QUOTA_GEMINI_3_1_FLASH_LITE_RPD=500
# QUOTA_GEMINI_3_8_FLASH_RPM=5
# QUOTA_GEMINI_3_8_FLASH_RPD=20
# QUOTA_GEMINI_3_6_FLASH_RPM=5
# QUOTA_GEMINI_3_6_FLASH_RPD=20
